      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "128 characters maximum." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "128 caractères maximum." } }
      }
    },
    "auth.password.tooShort" : {
      "comment" : "Même borne que AuthLimits.passwordMinLength et que l'API.",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "At least 12 characters." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "12 caractères minimum." } }
      }
    },
    "auth.signIn.submit" : {
