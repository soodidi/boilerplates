      }
    },
    "auth.signUp.sent %@" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "If this address can be used, an e-mail has been sent to %@. Open the link it contains, then come back to sign in." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Si cette adresse peut être utilisée, un e-mail vient d'être envoyé à %@. Ouvrez le lien qu'il contient, puis revenez vous connecter." } }
      }
    },
