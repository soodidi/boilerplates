# GLB-005 : toutes les variables, sans valeurs réelles. Copier en .env pour le développement.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# PostgreSQL local (compose.yaml)
DATABASE_URL=postgres://app:app@localhost:5432/app

# Origines autorisées (CORS), séparées par des virgules. Jamais « * » (BE-006).
CORS_ORIGINS=http://localhost:5173

# Authentification (BE-006). Secret : `openssl rand -base64 32`, différent dans chaque environnement.
APP_NAME="Mon app"
BETTER_AUTH_SECRET=change-me-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
# Rate limiting de l'auth : actif par défaut avec NODE_ENV=production (donc aussi dans npm run stack).
# Décommenter pour le couper pendant des essais manuels répétés.
# AUTH_RATE_LIMIT=false
# Front : lien des e-mails « vous avez déjà un compte ».
WEB_URL=http://localhost:5173

# Proxys de confiance devant l'API (BE-006) : 1 derrière Scaleway Serverless Containers.
TRUST_PROXY_HOPS=1

# E-mails (BE-009). En local : Mailpit (compose.yaml), boîte de réception sur http://localhost:8025.
# Staging et production : smtp://<ID du projet Scaleway>:<clé secrète API>@smtp.tem.scaleway.com:587
SMTP_URL=smtp://localhost:1025
# SMTP sans TLS avec NODE_ENV=production : Mailpit local uniquement (npm run stack). Jamais en staging ni en prod.
SMTP_INSECURE=false
MAIL_FROM="Mon app <noreply@localhost>"
# Staging : adresses autorisées, séparées par des virgules. Vide = tous les destinataires.
MAIL_ALLOWED_RECIPIENTS=

# Documentation OpenAPI sur /docs (désactivée en production par défaut).
ENABLE_DOCS=true

# Sentry (BE-007) : vide = désactivé.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# SHA du commit, injecté au build de l'image.
APP_VERSION=dev
