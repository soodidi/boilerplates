# GLB-005 : toutes les variables, sans valeurs réelles. Copier en .env pour le développement.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# PostgreSQL local (compose.yaml)
DATABASE_URL=postgres://app:app@localhost:5432/app

# Origines autorisées (CORS), séparées par des virgules. Jamais « * » (BE-006).
CORS_ORIGINS=http://localhost:5173

# E-mails (BE-009). En local : Mailpit (compose.yaml), boîte de réception sur http://localhost:8025.
# Staging et production : smtp://<ID du projet Scaleway>:<clé secrète API>@smtp.tem.scaleway.com:587
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Mon app <noreply@localhost>"
# Staging : adresses autorisées, séparées par des virgules. Vide = tous les destinataires.
MAIL_ALLOWED_RECIPIENTS=

# Documentation OpenAPI sur /docs (désactivée en production par défaut).
ENABLE_DOCS=true

# Sentry (BE-007) : vide = désactivé.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# SHA du commit, injecté au build de l'image.
APP_VERSION=dev
