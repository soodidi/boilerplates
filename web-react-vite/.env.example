# Variables de BUILD (lues par Vite et la CI). La configuration d'exécution
# (URL d'API, DSN Sentry, environnement) est dans public/config.json (OPS-004).

# SHA du commit, injecté par la CI : sert de `release` Sentry (FE-009).
VITE_APP_VERSION=dev

# Upload des source maps vers Sentry (CI uniquement, FE-009). Laisser vide en local.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
