root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
# AND-005 : style officiel Kotlin, vérifié par ktlint.
ktlint_code_style = ktlint_official
max_line_length = 140
# Les composables commencent par une majuscule.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{yml,yaml,json,toml}]
indent_size = 2
